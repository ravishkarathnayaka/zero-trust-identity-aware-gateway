# ==============================================================================
# Zero Trust Network Access (ZTNA) Gateway Environment Configuration
# NIST SP 800-207 Architecture
# ==============================================================================

# Keycloak Identity Provider (IdP)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ztna-realm
KEYCLOAK_CLIENT_ID=ztna-gateway
KEYCLOAK_CLIENT_SECRET=ztna-gateway-secret-dev-key

# Envoy Proxy Policy Enforcement Point (PEP)
ENVOY_HTTPS_PORT=8443
ENVOY_HTTP_PORT=8000
ENVOY_ADMIN_PORT=9901

# Open Policy Agent Policy Decision Point (PDP)
OPA_PORT=8181
OPA_URL=http://opa:8181

# ExtAuthz Policy Administrator Service
EXT_AUTHZ_PORT=9001
VERIFY_JWT_SIGNATURE=false
LOG_LEVEL=INFO

# Sample User Credentials for Testing:
# Alice (Finance Admin) : alice / password123
# Bob (Engineering)     : bob / password123
# Charlie (Auditor)     : charlie / password123
# Eve (Guest User)      : eve / password123
