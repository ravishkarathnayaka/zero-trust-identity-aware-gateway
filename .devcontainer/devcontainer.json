{
  "name": "Zero Trust Gateway Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "tsandall.opa",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "opa.dependency_paths": {
          "policies": "${workspaceFolder}/policies"
        }
      }
    }
  },
  "forwardPorts": [8443, 8000, 8080, 8181, 9001, 3000],
  "postCreateCommand": "pip install --upgrade pip && pip install -r gateway/ext_authz_service/requirements.txt && pip install pytest pytest-cov flake8"
}
